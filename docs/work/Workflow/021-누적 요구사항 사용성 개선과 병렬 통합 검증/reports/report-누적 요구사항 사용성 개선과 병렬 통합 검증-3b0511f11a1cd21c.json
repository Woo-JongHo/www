      "work": {
        "status": "in_progress",
        "blockedReason": null,
        "criteria": [
          {
            "id"         : "SESSION-PLAN",
            "description": "기존 미완료 작업 UUID와 사용자 우려를 누락 없이 연결하고 단위별 소유·제외 파일, 의존성, 모델, 검증 방법을 실행 계획과 칸반 원장에 기록한다.",
            "required"   : true,
            "result"     : "unverified",
            "evidence": []
          },
          {
            "id"         : "SESSION-INTEGRATION",
            "description": "독립 작업은 병렬 수행하고 공유 파일은 단일 소유자로 통합한다. 실제 저작 호출과 주입 하네스를 구분하며 현재 통합 소스의 타입·소스 정책·구조·집중 테스트·빌드 결과를 기록한다.",
            "required"   : true,
            "result"     : "unverified",
            "evidence": []
          },
          {
            "id"         : "SESSION-USABILITY",
            "description": "명세의 실제 사용자 여정을 화면·API·기록·재조회·복귀까지 검사하고 정상·빈 자료·실패·중단·복원·경합 및 미실행 환경을 구분한다. 작업별 증거와 독립 검토가 충족된 경우만 해당 업무를 완료한다.",
            "required"   : true,
            "result"     : "unverified",
            "evidence": []
          },
          {
            "id"         : "SESSION-CLOSEOUT",
            "description": "관련 작업별 현재 완료 여부·차단·남은 행동을 칸반과 보고서로 읽을 수 있게 남긴다. 실제 플랫폼·모델·검토 미실행은 완료로 바꾸지 않으며 저장소 최종 검사와 게시 여부를 구분한다.",
            "required"   : true,
            "result"     : "unverified",
            "evidence": []
          }
        ],
        "verifications": [],
        "reviews": []
      },
