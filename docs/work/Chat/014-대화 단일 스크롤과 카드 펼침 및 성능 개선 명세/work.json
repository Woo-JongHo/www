  "criteria": [
    {
      "id"         : "AC-1",
      "description": "Chat 본문은 대화 전체만 세로 스크롤하며 명령·코드·diff 카드에 독립 세로 스크롤이 없고 입력창은 고정된다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-2",
      "description": "선택한 명령 출력은 ^T 표시 버튼과 Control+T로 같은 자리에서 펼침·접힘을 전환하며 다른 카드와 입력창의 상태를 바꾸지 않는다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-3",
      "description": "펼침은 보관된 원문 최대 32768 UTF-16 코드 단위 범위로 제한하고 생략·보관 초과를 명시하며 원문 복사와 JSON 보기의 의미를 보존한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-4",
      "description": "출력 증가·펼침·접힘·대화 전환에서 최신 추적과 과거 읽기 위치 및 카드별 수동 선택을 보존한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-5",
      "description": "동일 환경·fixture의 변경 전후 입력·스크롤·스트리밍을 계측하고 불필요한 완료 카드 재렌더와 반복 계산을 줄이며 입력 지연과 긴 프레임의 개선 및 미해결을 보고한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-6",
      "description": "실제 Electron에서 휠·키보드·긴 출력·실시간 출력·실패·대화 전환 시나리오와 관련 집중 테스트·소스 정책·타입 검사·빌드를 검증한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-7",
      "description": "P0: 입력 중 한글 조합·Enter·커서 편집·붙여넣기·인용·초안 복원을 보존하고, 스트리밍 유무별 입력 표시 지연을 계측해 입력으로 인한 불필요한 대화 전체 처리를 제거한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-8",
      "description": "현재 대화의 Working 상태를 입력창 위 고정 줄에서 확인하고 전송·시작 대기·실행·승인·중단 확인·종료·실패·연결 미확인을 실제 상태에 맞게 구분한다. 과거 스크롤·모니터 접힘·대화 전환에서도 해당 상태가 정확히 보인다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-9",
      "description": "99_www의 기본 WWW Mint 팔레트를 매트릭스 계열 기본안으로 앱 공통 의미 토큰에 연결하고 본문·보조·진행·정보·대기·오류·구문 역할을 구분한다. 실제 배경별 대비와 색 외 상태 문구·아이콘을 검증한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-10",
      "description": "Working 상태 갱신과 테마 적용 후에도 Input P0 성능 기준 및 한글 조합·스크롤·포커스를 보존하며 과거 읽기·좁은 창·모션 축소·상태 전이 시나리오를 실제 Electron에서 검증한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-11",
      "description": "활성 턴이 확인된 작업 중 입력창의 Steer 동작으로 같은 턴에 추가 지시를 보내며 원래 실행 중단·새 턴 시작 없이 Working을 유지하고 대기 중 일반 전송과 구분한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-12",
      "description": "Steer를 세션 API·preload IPC·main·Native turn/steer에 연결하고 session/selection/thread/expectedTurnId를 검사하며 응답 turnId를 확인한다. 추가 메시지 ID로 pending·접수·이력을 연결해 중복과 다른 세션 전달을 방지한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-13",
      "description": "Steer의 시작 대기·승인·중단·턴 종료 경합·불일치·미지원·전송 실패·접수 미확인을 구분하고 입력 원문과 새 초안을 보존한다. 자동 재전송·새 턴 전환을 하지 않고 중복 전송을 막는다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    },
    {
      "id"         : "AC-14",
      "description": "Steer의 같은 턴 전달·연속 입력·IME·원문 복원·다른 세션 격리를 집중 테스트와 실제 Electron에서 검증하며 실제 Native 후속 행동 반영과 API 접수 성공을 구분하고 Input P0 성능을 보존한다.",
      "required"   : true,
      "result"     : "unverified",
      "evidence": []
    }
  ],
