{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal desktop view for Codex app-server",
  "main": "dist/main.js",
  "scripts": {
    "setup": "npm install",
    "build": "bun run build.ts",
    "build:tauri-ui": "bun run spikes/tauri/build.ts",
    "package:electron": "npm run build && electron-packager . WWW-Electron --platform=darwin --arch=arm64 --out=.www/packages --overwrite --prune --ignore='^/(spikes|skill-library|test|docs|\\.git|\\.www|scripts/check-skill-library\\.ts)'",
    "package:tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" npm --prefix spikes/tauri run tauri -- build",
    "benchmark:comparison": "node spikes/tauri/scripts/compare.ts",
    "workflow": "node scripts/workflow.ts",
    "workflow:work": "node scripts/workflow/work.ts",
    "check:workflow": "node scripts/check-workflow.ts",
    "tauri": "npm --prefix spikes/tauri run tauri",
    "test:comparison": "npm test && npm run build:tauri-ui && \"$HOME/.cargo/bin/cargo\" test --manifest-path spikes/tauri/src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test": "node scripts/test.ts",
    "check:architecture": "node scripts/check-architecture.ts",
    "check": "npm run check:environment && npm run check:architecture && npm run check:source && npm run check:workflow && npm run typecheck && npm test && npm run build",
    "check:environment": "node scripts/check-environment.ts",
    "start": "npm run build && electron .",
    "check:source": "node scripts/source-policy.ts",
    "version:info": "node scripts/release.ts build-info",
    "release:verify": "node scripts/release.ts verify",
    "release:package": "node scripts/release.ts package",
    "setup:ci": "node scripts/setup-ci.ts",
    "release:check": "node scripts/release.ts check"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^39.2.1",
    "typescript": "^5.9.3"
  },
  "releaseBase": "0f7661ded359b69a95cbdde67392287d63fffb69"
}
