{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WWW Tauri Comparison",
  "version": "0.1.0",
  "identifier": "dev.woo.www.tauri-comparison",
  "build": {
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WWW",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}
