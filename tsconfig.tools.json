{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module"                    : "NodeNext",
    "moduleResolution"          : "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly"        : true,
    "verbatimModuleSyntax"      : true
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "spikes/tauri/scripts/**/*.ts"
  ]
}
