{
  "compilerOptions": {
    "target"          : "ES2022",
    "module"          : "ESNext",
    "moduleResolution": "Bundler",
    "jsx"             : "react-jsx",
    "strict"          : true,
    "noEmit"          : true,
    "types": [
      "bun",
      "node"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "build.ts"
  ]
}
